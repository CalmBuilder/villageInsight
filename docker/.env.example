# docker/docker-compose-base.yml 使用的 PostgreSQL 容器配置。
# 首次部署时将本文件复制为 docker/.env。docker/.env 已被 Git 忽略，可以保存生产
# 密码；服务器上应将文件权限设置为 600。

# PostgreSQL 镜像来源。无需修改 Compose，即可将默认官方镜像替换为经过验收的国内
# 镜像，例如：
# POSTGRES_IMAGE=uhej0txoqzpd9n.xuanyuan.run/postgres:17-alpine
# 生产环境完成验收后，建议使用 @sha256 固定不可变镜像摘要。
POSTGRES_IMAGE=postgres:17-alpine

# 初始数据库身份信息。这些值仅在 PGDATA 第一次初始化时生效；修改它们不会重命名已有
# 数据库，也不会重置已有数据库用户的密码。
# API 和 Worker 在宿主机运行时，这些值必须与根目录 .env 中的 DATABASE_URL 一致。
# 生产环境必须替换示例密码。
POSTGRES_DB=village_insight
POSTGRES_USER=village_insight
POSTGRES_PASSWORD=village_insight

# 全容器模式下 API 和 Worker 使用的数据库连接。用户名、密码和数据库名必须与上面
# 三项一致；主机名必须使用 Compose 服务名 postgres，端口必须使用容器端口 5432，
# 不能填写宿主机映射端口。密码包含特殊字符时必须按 URL 规则进行百分号编码。
POSTGRES_APPLICATION_URL=postgresql+psycopg://village_insight:village_insight@postgres:5432/village_insight

# 容器和 PostgreSQL 客户端时区。应用记录仍使用带时区时间；这里主要用于让数据库日志
# 和命令输出与服务器运维时区一致。
TZ=Asia/Shanghai
PGTZ=Asia/Shanghai

# 可选的首次初始化参数。PGDATA 初始化完成后将不再生效。不要尝试修改已有数据库集群的
# locale，也不要使用初始化脚本替代 Alembic 迁移。
# POSTGRES_INITDB_ARGS=--encoding=UTF8 --locale=C

# app.sh 和其他宿主机工具使用的数据库映射地址和端口。默认只监听 127.0.0.1；容器
# 之间始终通过 postgres:5432 通信。确需远程访问时，应同时配置防火墙和数据库访问
# 控制，不能只把监听地址改为 0.0.0.0。
POSTGRES_BIND_ADDRESS=127.0.0.1
EXPOSE_POSTGRES_PORT=5432

# PostgreSQL 数据存储位置。留空时使用 Docker 命名卷
# village_insight_postgres_data；生产环境可以设置绝对路径，例如：
# POSTGRES_DATA_DIR=/opt/village-insight/data/postgres/data
# 从已有命名卷切换到空目录不会自动复制数据，而是得到一个新数据库集群。切换前必须
# 完成并校验 pg_dump/pg_restore，停止写入，并准备好目标目录的属主和权限。
POSTGRES_DATA_DIR=

# PostgreSQL 内存和 WAL 参数。以下是偏保守的单机默认值。没有核对服务器内存、连接数
# 和写入量之前，不要直接复制其他服务器的较大参数：work_mem 可能被多个查询操作并发
# 使用，effective_cache_size 只是提供给查询规划器的估算值。
POSTGRES_SHARED_BUFFERS=512MB
POSTGRES_EFFECTIVE_CACHE_SIZE=2GB
POSTGRES_WORK_MEM=4MB
POSTGRES_MAINTENANCE_WORK_MEM=128MB
POSTGRES_WAL_BUFFERS=16MB

# 检查点和 WAL 控制。max_wal_size 是检查点目标值，不是磁盘占用硬上限；WAL 压缩
# 可以减少写入量，但会增加一定 CPU 开销。
POSTGRES_CHECKPOINT_TIMEOUT=5min
POSTGRES_CHECKPOINT_COMPLETION_TARGET=0.9
POSTGRES_MAX_WAL_SIZE=1GB
POSTGRES_MIN_WAL_SIZE=256MB
POSTGRES_WAL_COMPRESSION=on

# 运维保护参数。限制并记录大型临时文件，并终止长时间空闲的事务，避免无限期保留锁或
# 旧版本数据。
POSTGRES_TEMP_FILE_LIMIT=2GB
POSTGRES_LOG_TEMP_FILES=100MB
POSTGRES_IDLE_TRANSACTION_TIMEOUT=5min
POSTGRES_LOG_CHECKPOINTS=on

# 当 PGDATA 所在文件系统的可用空间低于此值（MiB）时，Compose 健康检查会把 PostgreSQL
# 标记为不健康。还应为 WAL 峰值、数据库备份和维护操作预留额外空间。
POSTGRES_MIN_FREE_DISK_MB=4096

# POSTGRES_DATA_DIR 留空时，Compose 将 PGDATA 保存在命名卷
# village_insight_postgres_data；配置绝对路径时则使用宿主机 bind mount。
# 项目目录 backups/four-layer-pre-restore 保存的是应用侧模板恢复前快照，与 PostgreSQL
# 容器中的 /backups 挂载不是同一类备份。
