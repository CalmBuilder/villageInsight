# VillageInsight 应用配置。
# 首次部署时将本文件复制为 .env。.env 已被 Git 忽略，可以保存本机配置，但不要把
# 生产环境的 API Key、数据库密码或初始化账号密码提交到仓库。

# 运行环境和应用日志级别。APP_ENV 不会自动启用全部生产安全配置；生产环境仍需单独
# 配置安全 Cookie、可信来源和 TLS。
APP_ENV=development
LOG_LEVEL=INFO

# app.sh 的监听地址、就绪等待和日志轮转参数。HOST 是前端监听地址；前端代理 API 时，
# API_HOST 通常应保持为本机回环地址。需要由浏览器直接访问 API 的来源还必须加入
# 可信来源列表 CORS_ORIGINS。
HOST=0.0.0.0
PORT=9137
API_HOST=127.0.0.1
API_PORT=9138
START_TIMEOUT_SECONDS=180
API_READY_TIMEOUT_SECONDS=60
STOP_TIMEOUT_SECONDS=15
LOG_MAX_BYTES=20971520
LOG_BACKUP_COUNT=5

# app.sh、Alembic 和本机命令使用的数据库连接。用户名、密码、数据库名和映射端口必须
# 与 docker/.env 一致。使用 Compose 的 application profile 运行全部应用容器时，
# compose.yaml 会覆盖此地址，让容器通过 postgres:5432 连接数据库。
# 密码包含特殊字符时，必须先按 URL 规则进行百分号编码。
DATABASE_URL=postgresql+psycopg://village_insight:village_insight@localhost:5432/village_insight

# 应用上传的原始物理证据目录。该目录必须使用持久化存储，并纳入受审计的服务器迁移
# 备份，不能只备份 PostgreSQL。
UPLOAD_ROOT=./data/uploads

# 用于解密供应商凭据的 Fernet 密钥。丢失或替换此文件会导致数据库中现有的加密
# API Key 无法读取；必须与数据库一起安全备份，迁移时不得生成新密钥覆盖。
SECRET_KEY_PATH=./data/secrets/settings.key

# 仅当恢复的服务器迁移包中仍包含旧服务器绝对路径时设置。该清单是服务器迁移工具生成
# 的只读证据，不得手工修改路径或摘要。
# SOURCE_PATH_MANIFEST=/data/server-transfer/source-manifest.json

# 允许用户从服务器侧导入的目录。配置多个根目录时使用英文逗号分隔；根目录之外的路径
# 会被拒绝。浏览器上传文件使用 UPLOAD_ROOT，不受此项替代。
IMPORT_ROOTS=./data/import

# 导入限制。MAX_UPLOAD_BYTES 是单文件上限，MAX_BATCH_FILES 是单批次文件上限。
# 前端上传并发数不应超过后端和网络的实际处理能力。
MAX_UPLOAD_BYTES=104857600
MAX_BATCH_FILES=500

# PostgreSQL 任务队列的轮询和租约时间。任务租约过期后可能被重新执行，因此处理逻辑
# 必须保持幂等。
WORKER_POLL_SECONDS=1.0
WORKER_LEASE_SECONDS=120

# 可用内存低于此阈值时拒绝启动 Worker 处理。并发数按解析、Hermes 识别和物化三条
# 独立工作通道分别配置。
WORKER_MIN_AVAILABLE_MEMORY_MB=4096
PARSE_WORKERS=2
HERMES_WORKERS=1
MATERIALIZE_WORKERS=1
VITE_UPLOAD_CONCURRENCY=2

# Hermes 默认启用。服务可以在模型参数为空时启动，但首次执行识别或问数前，必须通过
# 设置页或下列变量配置供应商、兼容的 Base URL、模型路由和有效凭据。
# 快速模型与推理模型可以不同；空值不代表允许回退到任意模型。
HERMES_ENABLED=true
HERMES_MODEL=
HERMES_FAST_MODEL=
HERMES_REASONING_MODEL=
HERMES_PROVIDER=
HERMES_BASE_URL=

# 供应商特定的思考参数协议。除非已经验证目标供应商支持相应协议，否则保持 none。
HERMES_THINKING_PROTOCOL=none

# 以下密钥仅在运行时读取。生产凭据优先通过设置页加密管理，不要在示例文件中填写真实值。
HERMES_API_KEY=
LLM_MULTIMODAL_API_KEY=
DEEPSEEK_API_KEY=

# Agent 执行限制。增加迭代次数或超时时间会提高延迟和成本；工具集必须使用显式白名单，
# 不得默认开放全部工具。
HERMES_MAX_ITERATIONS=8
# 不设置时使用供应商或模型的原生输出上限。只有明确需要缩小单次回复上限时才设置正整数。
# HERMES_MAX_TOKENS=4096
HERMES_THINKING_ENABLED=false
HERMES_REASONING_EFFORT=high
# HERMES_TIMEOUT_SECONDS 是单次供应商请求超时；HERMES_RECOGNITION_TIMEOUT_SECONDS
# 是完整多轮识别任务的总上限，总上限必须大于单次请求超时。
HERMES_TIMEOUT_SECONDS=120
HERMES_RECOGNITION_TIMEOUT_SECONDS=900
HERMES_ENABLED_TOOLSETS=

# 浏览器安全配置。这里只允许填写可信来源。生产 Cookie 必须通过 HTTPS 传输，并设置
# SESSION_COOKIE_SECURE=true；本机开发环境保持 false。
CORS_ORIGINS=http://localhost:5173
SESSION_COOKIE_NAME=vi_session
SESSION_LIFETIME_HOURS=12
SESSION_COOKIE_SECURE=false

# app.sh 和全容器模式会在迁移后显式执行初始化命令，只创建平台管理员 admin 和演示
# 操作员 demo。密码不会在重复执行时被重置。生产环境必须在首次启动前替换账号密码。
BOOTSTRAP_PLATFORM_TENANT_NAME=管理员租户
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_OPERATOR_USERNAME=demo
BOOTSTRAP_TENANT_NAME=演示租户
BOOTSTRAP_TOWNSHIP_NAME=示例乡镇
BOOTSTRAP_VILLAGE_NAME=示例村
BOOTSTRAP_PASSWORD=VillageInsight-ChangeMe-2026
